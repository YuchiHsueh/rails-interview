<%= form_with(model: [todo_list, item], class: "mb-3") do |f| %>
  <div class="mb-3">
    <%= f.text_field :title,
                     class: "form-control",
                     placeholder: "Enter new item title...",
                     required: true %>
  </div>
  <div class="input-group">
    <%= f.text_field :description,
                     class: "form-control",
                     placeholder: "Enter new item description..." %>
    <%= button_tag(type: 'submit', class: "btn btn-primary submit-btn") do %>
      <span class="button-text">
      + Add new Item
      </span>
      <i class="fa-solid fa-square-plus plus-submit-icon"></i>
    <% end %>
  </div>
<% end %>
