<%= form_with(model: todo_list, data: { turbo: true }) do |f| %>
  <% if todo_list.errors.any? %>
    <div class="alert alert-danger">
      <ul class="mb-0">
        <% todo_list.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="input-group">
    <%= f.text_field :name,
                     class: "form-control",
                     placeholder: "Enter new todo list name...",
                     required: true,
                     data: {
                       controller: "reset-form",
                       action: "keyup->reset-form#clearOnEscape"
                     } %>
    <%= button_tag(type: 'submit', class: "btn btn-primary submit-btn") do %>
      <span class="button-text">
        <%= todo_list.persisted? ? "Update Todo List" : "Create a new Todo List" %>
      </span>
      <i class="fa-solid <%= todo_list.persisted? ? "fa-wrench" : "fa-square-plus" %> plus-submit-icon"></i>
    <% end %>
  </div>
<% end %>
