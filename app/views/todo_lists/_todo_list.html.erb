<%= turbo_frame_tag dom_id(todo_list) do %>
  <div class="list-group-item list-group-item-action">
    <div class="d-flex justify-content-between align-items-center">
      <h5 class="mb-1">
        <%= link_to todo_list.name,
            todo_list_path(todo_list),
            class: "text-decoration-none",
            data: { turbo_frame: "_top" } %>
      </h5>
      <div>
        <%= link_to edit_todo_list_path(todo_list),
            class: "btn btn-sm btn-warning me-2 edit-btn",
            data: { turbo_frame: "_top" } do %>
          <i class="fa-solid fa-pen-to-square pen-square-icon"></i>
          <i class="fa-solid fa-pen pen-icon"></i>
        <% end %>
        <%= button_to todo_list_path(todo_list),
            method: :delete,
            class: "btn btn-sm btn-danger delete-btn",
            form: { class: 'd-inline', data: { turbo_confirm: 'Are you sure you want to delete this todo list?' } } do %>
          <i class="fa-solid fa-trash trash-icon"></i>
          <i class="fa-solid fa-xmark x-icon"></i>
        <% end %>
      </div>
    </div>
  </div>
<% end %>
